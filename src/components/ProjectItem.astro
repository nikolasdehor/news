---
/**
 * Item do catálogo (home): cartão compacto em grade densa. O nome é um
 * link esticado que cobre o cartão; os links externos ficam acima dele.
 */
import { linksDoProjeto, type Projeto } from '../lib/projetos';

interface Props {
  projeto: Projeto;
  posts: number;
}

const { projeto: p, posts } = Astro.props;
const links = linksDoProjeto(p);
---

<article class="item">
  <h4 class="item__nome">
    <a href={`/${p.slug}/`} class="esticado">{p.nome}</a>
  </h4>
  <p class="item__desc">{p.descricao}</p>
  <p class="item__meta">
    <span class="item__stack">{p.stack.join(' / ')}</span>
    {p.status !== 'ativo' && <span class="marca">{p.status}</span>}
    {p.visibilidade === 'privado' && <span class="marca">privado</span>}
    {posts > 0 && <span class="marca marca--acento">{posts} {posts === 1 ? 'edição' : 'edições'}</span>}
  </p>
  {links.length > 0 && (
    <p class="item__links">
      {links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener noreferrer" class="link-external"
           aria-label={`${l.rotulo} de ${p.nome} (abre em nova aba)`}>{l.rotulo}</a>
      ))}
    </p>
  )}
</article>
