---
import { getCollection } from 'astro:content';
import Head from '../../components/Head.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import { PROJETOS, SEMANA, CATEGORIAS, porSlug, linksDoProjeto } from '../../lib/projetos';
import '../../styles/global.css';

export async function getStaticPaths() {
  const todos = await getCollection('posts', ({ data }) => !data.draft);
  const slugs = new Set([...PROJETOS.map((p) => p.slug), SEMANA.slug, ...todos.map((p) => p.data.project)]);

  return [...slugs].map((project) => ({
    params: { project },
    props: {
      posts: todos
        .filter((p) => p.data.project === project)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { project } = Astro.params;
const { posts } = Astro.props;

const ficha = porSlug(project);
const meta = ficha
  ? { nome: ficha.nome, desc: ficha.descricao, tags: ficha.stack }
  : project === SEMANA.slug
    ? { nome: SEMANA.nome, desc: SEMANA.descricao, tags: [] as string[] }
    : { nome: project, desc: `Diário de bordo do projeto ${project}.`, tags: [] as string[] };
const links = ficha ? linksDoProjeto(ficha) : [];
const categoria = ficha && CATEGORIAS.find((c) => c.id === ficha.categoria)?.nome;

const totalEdicoes = posts.length;

// Inscrição por email só existe para projetos com audience no Resend
const projetosSubscribe = [
  { slug: 'mcp-fiscal-brasil', label: 'MCP Fiscal Brasil' },
  { slug: 'mcp-juridico-brasil', label: 'MCP Jurídico Brasil' },
];
const temNewsletter = projetosSubscribe.some((p) => p.slug === project);
---

<html lang="pt-BR">
  <head>
    <Head
      title={meta.nome}
      description={meta.desc}
      canonicalURL={new URL(`/${project}/`, Astro.site)}
      project={project}
    />
    <link rel="icon" type="image/png" href="/logo-mcp-fiscal.png" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Nav />

    <!-- Cabecalho do projeto -->
    <section class="project-hero" aria-labelledby="project-title">
      <div class="project-hero__inner">
        <a href="/" class="back-link">&larr; Projetos</a>

        <h1 class="project-hero__title" id="project-title">{meta.nome}</h1>
        <p class="project-hero__desc">{meta.desc}</p>

        {(ficha || meta.tags.length > 0) && (
          <div class="project-hero__badges">
            {ficha && <span class={`badge${ficha.status === 'ativo' ? ' badge--accent' : ''}`}>{ficha.status}</span>}
            {categoria && <span class="badge">{categoria}</span>}
            {ficha?.visibilidade === 'privado' && <span class="badge">privado</span>}
            {meta.tags.map((tag) => (
              <span class="badge">{tag}</span>
            ))}
          </div>
        )}

        <div class="project-hero__links">
          {links.map((l) => (
            <a
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link-external"
              aria-label={`${l.rotulo} de ${meta.nome} (abre em nova aba)`}
            >
              {l.rotulo}
            </a>
          ))}
          <a
            href={`/${project}/rss.xml`}
            class="link-external"
            aria-label={`Feed RSS do projeto ${meta.nome}`}
          >
            RSS
          </a>
        </div>
      </div>
    </section>

    <main>
      <section class="section" aria-labelledby="edicoes-titulo">
        <div class="container">
          <h2 class="section-label" id="edicoes-titulo">
            {totalEdicoes} {totalEdicoes === 1 ? 'edição publicada' : 'edições publicadas'}
          </h2>
          {totalEdicoes === 0 && (
            <p class="empty-state">
              {ficha?.visibilidade === 'privado'
                ? 'Ainda não há publicações sobre este projeto. Por ser privado, ele aparece só em alto nível no diário da semana.'
                : 'Ainda não há publicações sobre este projeto. Novas versões e mudanças relevantes entram aqui e no diário da semana.'}
              {project !== SEMANA.slug && <> <a href={`/${SEMANA.slug}/`}>Ver o diário da semana &rarr;</a></>}
            </p>
          )}
          <div class="editions-list">
            {posts.map((post, idx) => {
              const [, ...restParts] = post.id.split('/');
              const slug = restParts.join('/');
              const numEdition = String(totalEdicoes - idx).padStart(2, '0');
              return (
                <article class="edition-row">
                  <p class="edition-number">EDIÇÃO {numEdition}</p>
                  <h3>
                    <a href={`/${project}/${slug}/`} class="edition-row__title">
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="edition-row__excerpt">{post.data.description}</p>
                  <div class="edition-row__meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('pt-BR', {
                        day: '2-digit',
                        month: 'long',
                        year: 'numeric',
                        timeZone: 'America/Sao_Paulo',
                      })}
                    </time>
                    <span aria-hidden="true">&middot;</span>
                    <a href={`/${project}/${slug}/`}>Ler &rarr;</a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    </main>

    <!-- Inscricao: projeto atual pre-marcado (só projetos com newsletter) -->
    {temNewsletter && (
      <SubscribeForm
        projects={projetosSubscribe}
        preChecked={[project]}
        heading={`Acompanhe o ${meta.nome}`}
      />
    )}

    <Footer />
  </body>
</html>
