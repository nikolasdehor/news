---
import { getCollection } from 'astro:content';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { PROJETOS, CATEGORIAS, nomeDoProjeto } from '../lib/projetos';
import '../styles/global.css';

const todos = await getCollection('posts', ({ data }) => !data.draft);

const contagem = todos.reduce((acc: Record<string, number>, post) => {
  acc[post.data.project] = (acc[post.data.project] ?? 0) + 1;
  return acc;
}, {});

// Catálogo agrupado por categoria, destaques primeiro
const grupos = CATEGORIAS.map((cat) => ({
  ...cat,
  itens: PROJETOS.filter((p) => p.categoria === cat.id)
    .sort((a, b) => Number(b.destaque) - Number(a.destaque)),
})).filter((g) => g.itens.length > 0);

// Posts recentes (todos, ordenados por data, max 10)
const recentes = [...todos]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const siteDescription = 'Portfólio, novidades e diário de bordo dos projetos de Nikolas de Hor: open source, produtos, dados públicos e For6 Solutions.';

// Projetos disponíveis para inscricao
const projetosSubscribe = [
  { slug: 'mcp-fiscal-brasil', label: 'MCP Fiscal Brasil' },
  { slug: 'mcp-juridico-brasil', label: 'MCP Jurídico Brasil' },
];

---

<html lang="pt-BR">
  <head>
    <Head
      title="news.dehor.com.br"
      description={siteDescription}
      canonicalURL={new URL('/', Astro.site)}
    />
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="icon" type="image/png" href="/logo-mcp-fiscal.png" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'DEHOR',
      url: 'https://news.dehor.com.br/',
      logo: 'https://news.dehor.com.br/favicon.svg',
      founder: { '@type': 'Person', name: 'Nikolas de Hor' },
      sameAs: ['https://github.com/nikolasdehor', 'https://github.com/DeHor-Labs'],
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'nikolasdehor79@gmail.com',
        contactType: 'customer support',
        availableLanguage: ['pt-BR'],
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Itajubá',
        addressRegion: 'MG',
        addressCountry: 'BR',
      },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'news.dehor.com.br',
      url: 'https://news.dehor.com.br/',
      inLanguage: 'pt-BR',
      publisher: { '@type': 'Organization', name: 'DEHOR' },
    })} />
  </head>
  <body>
    <Nav />

    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__eyebrow">Portfólio &middot; Itajubá, Brasil</p>
        <h1 class="hero__title" id="hero-title">
          Projetos e novidades<br />de Nikolas de Hor
        </h1>
        <p class="hero__subtitle">
          Open source, produtos, dados públicos, trabalhos da For6 Solutions e projetos acadêmicos, com um diário de bordo semanal.
        </p>
      </div>
    </section>

    <main>
      <!-- Posts recentes -->
      <section class="section" aria-labelledby="recentes-titulo">
        <div class="container">
          <h2 class="section-label" id="recentes-titulo">Publicações recentes</h2>
          <div class="posts-list">
            {recentes.map((post) => {
              const [project, ...restParts] = post.id.split('/');
              const slug = restParts.join('/');
                            return (
                <article class="post-item">
                  <div class="post-item__meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('pt-BR', {
                        day: '2-digit',
                        month: 'short',
                        year: 'numeric',
                        timeZone: 'America/Sao_Paulo',
                      })}
                    </time>
                    <span class="post-item__meta-dot" aria-hidden="true">&middot;</span>
                    <a href={`/${project}/`}>{nomeDoProjeto(project)}</a>
                  </div>
                  <h3>
                    <a href={`/${project}/${slug}/`} class="post-item__title">
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="post-item__excerpt">{post.data.description}</p>
                </article>
              );
            })}
          </div>
        </div>
      </section>
      <!-- Portfólio -->
      <section class="section" aria-labelledby="projetos-titulo">
        <div class="container">
          <h2 class="section-label" id="projetos-titulo">Projetos</h2>
          <nav class="categoria-nav" aria-label="Categorias de projetos">
            {grupos.map((g) => (
              <a href={`#${g.id}`} class="badge">{g.nome} &middot; {g.itens.length}</a>
            ))}
          </nav>
          {grupos.map((g) => (
            <div class="categoria" id={g.id}>
              <h3 class="categoria__titulo">{g.nome}</h3>
              <div>
                {g.itens.map((p) => <ProjectItem projeto={p} posts={contagem[p.slug] ?? 0} />)}
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <!-- Inscricao na newsletter -->
    <SubscribeForm
      projects={projetosSubscribe}
      heading="Receba as novidades"
    />

    <Footer />
  </body>
</html>
