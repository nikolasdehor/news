{
  "framework": "astro",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Vary": "Accept"
      }
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</sitemap-index.xml>; rel=\"sitemap\"; type=\"application/xml\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\""
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "<https://news.dehor.com.br/>; rel=\"canonical\"; type=\"text/html\""
        }
      ]
    }
  ]
}
